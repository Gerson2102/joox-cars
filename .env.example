# The CMS at /admin (docs/CMS.md). Set these in Vercel → Settings → Environment Variables.
# Locally none are needed: open http://localhost:3000/admin/index.html and choose
# "Work with Local Repository".

# The GitHub OAuth app the client signs in with (callback URL: https://jooxcars.com/api/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The key in the secret link that unlocks /admin: https://jooxcars.com/admin?key=THE_KEY
# Generate one with: node scripts/generate-key.mjs
CMS_ADMIN_KEY=
